{"legislative_session": "153", "identifier": "HB 448", "title": "AN ACT TO AMEND TITLE 15 OF THE DELAWARE CODE RELATING TO CAMPAIGN EXPENDITURES.", "from_organization": "~{\"classification\": \"lower\"}", "classification": ["bill"], "subject": [], "abstracts": [{"note": "synopsis", "abstract": "This Act makes security expenses an authorized campaign expenditure.   The security expenses must be: (1) related to ensuring the safety of the candidate; and (2) associated with the candidate\u2019s activities, duties, or status as a candidate or elected official. Security expenses include home or office electronic security systems, personal security, and other security-related equipment or devices for a candidate.  Security expenses may not be used to purchase firearms.\r\nThis Act requires that the Commissioner promulgate rules to implement this Act within 3 months."}], "other_titles": [{"note": "short title", "title": "Security Expenses/Authorized Campaign Expenditure"}], "other_identifiers": [{"identifier": "ocd-bill-de-153-hb448"}], "actions": [{"description": "Introduced and Assigned to Elections & Government Affairs Committee in House", "date": "2026-06-04", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["introduction", "referral-committee"], "related_entities": [{"name": "Elections & Government Affairs", "entity_type": "organization", "organization_id": null}]}, {"description": "Reported Out of Committee (Elections & Government Affairs) in House with 2 Favorable, 3 On Its Merits", "date": "2026-06-10", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["committee-passage", "committee-passage-favorable"], "related_entities": [{"name": "Elections & Government Affairs", "entity_type": "organization", "organization_id": null}]}, {"description": "Passed By House. Votes: 25 YES 8 NO 6 NOT VOTING 2 ABSENT", "date": "2026-06-11", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["passage"], "related_en