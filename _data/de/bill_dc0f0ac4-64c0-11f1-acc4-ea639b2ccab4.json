{"legislative_session": "153", "identifier": "HB 417", "title": "AN ACT TO AMEND TITLE 30 OF THE DELAWARE CODE RELATING TO RESTAURANT RETAILER LICENSE REQUIREMENTS AND LICENSE FEES.", "from_organization": "~{\"classification\": \"lower\"}", "classification": ["bill"], "subject": [], "abstracts": [{"note": "synopsis", "abstract": "This Act raises the monthly deduction on taxable gross receipts allowed by restaurants from $100,000 to $250,000.  Accordingly, the quarterly deduction allowed for restaurants with gross receipts of no more than 1.5 million in the previous year is increased from $300,000 to $750,000."}], "other_titles": [{"note": "short title", "title": "Restaurants/Gross Receipts Tax/Updates"}], "other_identifiers": [{"identifier": "ocd-bill-de-153-hb417"}], "actions": [{"description": "Introduced and Assigned to Revenue & Finance Committee in House", "date": "2026-05-12", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["introduction", "referral-committee"], "related_entities": [{"name": "Revenue & Finance", "entity_type": "organization", "organization_id": null}]}], "sponsorships": [{"name": "Kimberly Williams", "classification": "primary", "entity_type": "person", "primary": true, "person_id": "~{\"chamber\": \"lower\", \"name\": \"Kimberly Williams\"}", "organization_id": null}, {"name": "John \"Jack\" Walsh", "classification": "primary", "entity_type": "person", "primary": true, "person_id": "~{\"chamber\": \"upper\", \"name\": \"John \\\"Jack\\\" Walsh\"}", "organization_id": null}], "related_bills": [], "versions": [], "documents": [{"note": "Fiscal Note", "links": [{"url": "https://legis.delaware.gov/json/BillDetail/GetPdfDocument?fileAttachmentId=655402", "media_type": "application/pdf"}], "date": "", "classification": ""}], "citations": [], "sources": [{"url": "https://legis.delaware.gov/BillDetail?LegislationId=143274", "note": "text/html"}], "extras": {}, "jurisdiction": {"id": "ocd-jurisdiction/country:us/state:de/gove