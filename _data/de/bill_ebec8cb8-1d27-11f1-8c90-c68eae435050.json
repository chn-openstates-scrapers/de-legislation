{"legislative_session": "153", "identifier": "SB 251", "title": "ACT TO AMEND TITLE 24 OF THE DELAWARE CODE RELATING TO UNBORN CHILDREN.", "from_organization": "~{\"classification\": \"upper\"}", "classification": ["bill"], "subject": [], "abstracts": [{"note": "synopsis", "abstract": "This Act protects the life of the unborn child at a time when the potential for the child to survive outside the womb increases, especially with the advancement of medical procedures. Specifically, this Act repeals the current sections of the Delaware Code relating to termination of human pregnancy and enacts The Pain-Capable Unborn Child Protection Act.\r\n\r\nThis Act also makes technical corrections to conform existing law to the standards of the Delaware Legislative Drafting Manual and corresponding changes to other sections of the Code."}], "other_titles": [], "other_identifiers": [], "actions": [{"description": "Introduced and Assigned to Health & Social Services Committee in Senate", "date": "2026-03-05", "organization_id": "~{\"classification\": \"upper\"}", "classification": ["introduction", "referral-committee"], "related_entities": [{"name": "Health & Social Services", "entity_type": "organization", "organization_id": null}]}], "sponsorships": [{"name": "Bryant L. Richardson", "classification": "primary", "entity_type": "person", "primary": true, "person_id": "~{\"chamber\": \"upper\", \"name\": \"Bryant L. Richardson\"}", "organization_id": null}, {"name": "Timothy D. Dukes", "classification": "primary", "entity_type": "person", "primary": true, "person_id": "~{\"chamber\": \"lower\", \"name\": \"Timothy D. Dukes\"}", "organization_id": null}, {"name": "David L. Wilson", "classification": "primary", "entity_type": "person", "primary": true, "person_id": "~{\"chamber\": \"upper\", \"name\": \"David L. Wilson\"}", "organization_id": null}, {"name": "Richard G. Collins", "classification": "primary", "entity_type": "person", "primary": true, "person_id": "~{\"chamber\": \"lowe