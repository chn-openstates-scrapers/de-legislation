{"legislative_session": "153", "identifier": "HB 427", "title": "AN ACT TO AMEND TITLE 11 OF THE DELAWARE CODE RELATING TO OFFENSES INVOLVING DEADLY WEAPONS AND DANGEROUS INSTRUMENTS.", "from_organization": "~{\"classification\": \"lower\"}", "classification": ["bill"], "subject": [], "abstracts": [{"note": "synopsis", "abstract": "This substitute bill allows target practicing with a BB gun, projectile weapon, or firearm by a 16 or 17 year old without direct supervision of a person age 21 or above provided the 16 or 17 year old has permission of a parent or guardian and the 16 or 17 year old has completed a hunter education course.\r\nAdditionally, a 16 or 17 year old is allowed to hunt without direct supervision if they are in possession of a valid Delaware hunting license."}], "other_titles": [], "other_identifiers": [{"identifier": "ocd-bill-de-153-hb427"}], "actions": [{"description": "was introduced and adopted in lieu of HB 427", "date": "2026-06-19", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["introduction"], "related_entities": []}], "sponsorships": [{"name": "Jeffrey N. Spiegelman", "classification": "primary", "entity_type": "person", "primary": true, "person_id": "~{\"chamber\": \"lower\", \"name\": \"Jeffrey N. Spiegelman\"}", "organization_id": null}, {"name": "William J. Carson", "classification": "primary", "entity_type": "person", "primary": true, "person_id": "~{\"chamber\": \"lower\", \"name\": \"William J. Carson\"}", "organization_id": null}, {"name": "Brian Pettyjohn", "classification": "primary", "entity_type": "person", "primary": true, "person_id": "~{\"chamber\": \"upper\", \"name\": \"Brian Pettyjohn\"}", "organization_id": null}, {"name": "Kerri Evelyn Harris", "classification": "primary", "entity_type": "person", "primary": true, "person_id": "~{\"chamber\": \"lower\", \"name\": \"Kerri Evelyn Harris\"}", "organization_id": null}, {"name": "John \"Jack\" Walsh", "classification": "primary", "entity_type": "p