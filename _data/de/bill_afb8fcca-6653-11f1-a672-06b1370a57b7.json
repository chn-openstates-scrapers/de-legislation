{"legislative_session": "153", "identifier": "HB 414", "title": "AN ACT TO AMEND TITLE 11 OF THE DELAWARE CODE RELATING TO POSSESSING A DESTRUCTIVE WEAPON.", "from_organization": "~{\"classification\": \"lower\"}", "classification": ["bill"], "subject": [], "abstracts": [{"note": "synopsis", "abstract": "This Act clarifies that the grant of exclusive jurisdiction to the Superior Court over violations of 11 Del C. \u00a7 1444 (possessing a destructive weapon), applies only to an adult defendant. Jurisdiction over minors remains with the Family Court."}], "other_titles": [{"note": "short title", "title": "Superior Ct. Jurisdiction/Destructive Weapon Violations"}], "other_identifiers": [{"identifier": "ocd-bill-de-153-hb414"}], "actions": [{"description": "Introduced and Assigned to Judiciary Committee in House", "date": "2026-05-12", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["introduction", "referral-committee"], "related_entities": [{"name": "Judiciary", "entity_type": "organization", "organization_id": null}]}, {"description": "Not Worked in Committee", "date": "2026-05-20", "organization_id": "~{\"classification\": \"lower\"}", "classification": [], "related_entities": []}], "sponsorships": [{"name": "Cyndie Romer", "classification": "primary", "entity_type": "person", "primary": true, "person_id": "~{\"chamber\": \"lower\", \"name\": \"Cyndie Romer\"}", "organization_id": null}, {"name": "Marie Pinkney", "classification": "primary", "entity_type": "person", "primary": true, "person_id": "~{\"chamber\": \"upper\", \"name\": \"Marie Pinkney\"}", "organization_id": null}], "related_bills": [], "versions": [], "documents": [], "citations": [], "sources": [{"url": "https://legis.delaware.gov/BillDetail?LegislationId=143264", "note": "text/html"}], "extras": {}, "jurisdiction": {"id": "ocd-jurisdiction/country:us/state:de/government", "name": "Delaware", "classification": "state", "division_id": "ocd-division/country:us/state:de"}, "scrap