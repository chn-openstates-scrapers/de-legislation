{"legislative_session": "153", "identifier": "SB 347", "title": "AN ACT TO AMEND TITLE 6 OF THE DELAWARE CODE RELATING TO THE MEDICAL DEBT PROTECTION ACT", "from_organization": "~{\"classification\": \"upper\"}", "classification": ["bill"], "subject": [], "abstracts": [{"note": "synopsis", "abstract": "This Act expands the scope of prohibited extraordinary collection actions to include a large health-care facility levying on tangible personal property of a patient. It also clarifies that any party taking action to collect medical debt must disclose in court pleadings whether the party is a large health-care facility, and makes technical corrections."}], "other_titles": [{"note": "short title", "title": "Medical Dept/Expand Scope/Prevent Property Levy"}], "other_identifiers": [{"identifier": "ocd-bill-de-153-sb347"}], "actions": [{"description": "Introduced and Assigned to Banking, Business, Insurance & Technology Committee in Senate", "date": "2026-06-16", "organization_id": "~{\"classification\": \"upper\"}", "classification": ["introduction", "referral-committee"], "related_entities": [{"name": "Banking, Business, Insurance & Technology", "entity_type": "organization", "organization_id": null}]}, {"description": "Reported Out of Committee (Banking, Business, Insurance & Technology) in Senate with 2 Favorable, 6 On Its Merits", "date": "2026-06-17", "organization_id": "~{\"classification\": \"upper\"}", "classification": ["committee-passage", "committee-passage-favorable"], "related_entities": [{"name": "Banking, Business, Insurance & Technology", "entity_type": "organization", "organization_id": null}]}, {"description": "Reported Out of Committee (Banking, Business, Insurance & Technology) in Senate with 2 Favorable, 6 On Its Merits", "date": "2026-06-17", "organization_id": "~{\"classification\": \"upper\"}", "classification": ["committee-passage", "committee-passage-favorable"], "related_entities": [{"name": "Banking, Business, Insurance & Technology", "entity_t