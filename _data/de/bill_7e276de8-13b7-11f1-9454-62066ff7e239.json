{"legislative_session": "153", "identifier": "HB 277", "title": "AN ACT TO AMEND TITLE 21 OF THE DELAWARE CODE RELATING TO SAFETY DURING TRAFFIC STOPS.", "from_organization": "~{\"classification\": \"lower\"}", "classification": ["bill"], "subject": [], "abstracts": [{"note": "synopsis", "abstract": "This Act codifies the Delaware State Police program that makes available a \u201cblue envelope\u201d for use by a person with a disability. The intent of this program is to increase safety for both officers and persons with a disability during a traffic stop. The envelope contains written information for officers regarding interacting with a person with a disability, as well as guidance for the person with a disability on safe interactions with law-enforcement during a traffic stop. The envelope is sized to be able to contain a driver\u2019s license, motor vehicle registration card, and insurance identification card and other related documents."}], "other_titles": [], "other_identifiers": [], "actions": [{"description": "Introduced and Assigned to Public Safety & Homeland Security Committee in House", "date": "2026-01-22", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["introduction", "referral-committee"], "related_entities": [{"name": "Public Safety & Homeland Security", "entity_type": "organization", "organization_id": null}]}], "sponsorships": [{"name": "DeShanna U Neal", "classification": "primary", "entity_type": "person", "primary": true, "person_id": "~{\"chamber\": \"lower\", \"name\": \"DeShanna U Neal\"}", "organization_id": null}, {"name": "Sarah McBride", "classification": "primary", "entity_type": "person", "primary": true, "person_id": "~{\"chamber\": \"upper\", \"name\": \"Sarah McBride\"}", "organization_id": null}, {"name": "Russell Huxtable", "classification": "primary", "entity_type": "person", "primary": true, "person_id": "~{\"chamber\": \"upper\", \"name\": \"Russell Huxtable\"}", "organization_id": null}, {"name": "Eric