{"legislative_session": "153", "identifier": "SB 247", "title": "AN ACT TO AMEND TITLES 9 AND 22 OF THE DELAWARE CODE RELATING TO COUNTY AND MUNICIPAL GOVERNMENT DEPOSITS OF FUNDS.", "from_organization": "~{\"classification\": \"upper\"}", "classification": ["bill"], "subject": [], "abstracts": [{"note": "synopsis", "abstract": "This bill clarifies that counties and municipalities can deposit their revenues in any depository bank or credit union. The State of Delaware already can choose where it deposits its money, and this legislation would extend that ability to counties and municipalities."}], "other_titles": [{"note": "short title", "title": "Bank/Credit Union/Counties/Municipalities/Revenues"}], "other_identifiers": [{"identifier": "ocd-bill-de-153-sb247"}], "actions": [{"description": "Introduced and Assigned to Banking, Business, Insurance & Technology Committee in Senate", "date": "2026-03-05", "organization_id": "~{\"classification\": \"upper\"}", "classification": ["introduction", "referral-committee"], "related_entities": [{"name": "Banking, Business, Insurance & Technology", "entity_type": "organization", "organization_id": null}]}, {"description": "Reported Out of Committee (Banking, Business, Insurance & Technology) in Senate with 5 Favorable", "date": "2026-03-18", "organization_id": "~{\"classification\": \"upper\"}", "classification": ["committee-passage", "committee-passage-favorable"], "related_entities": [{"name": "Banking, Business, Insurance & Technology", "entity_type": "organization", "organization_id": null}]}], "sponsorships": [{"name": "Spiros Mantzavinos", "classification": "primary", "entity_type": "person", "primary": true, "person_id": "~{\"chamber\": \"upper\", \"name\": \"Spiros Mantzavinos\"}", "organization_id": null}, {"name": "William Bush", "classification": "primary", "entity_type": "person", "primary": true, "person_id": "~{\"chamber\": \"lower\", \"name\": \"William Bush\"}", "organization_id": null}, {"name": "Marie Pinkney"