{"legislative_session": "153", "identifier": "HB 322", "title": "AN ACT TO AMEND TITLE 11 OF THE DELAWARE CODE RELATING TO ARREST AND DETENTION.", "from_organization": "~{\"classification\": \"lower\"}", "classification": ["bill"], "subject": [], "abstracts": [{"note": "synopsis", "abstract": "This Act permits employees of, or security personnel working for, a health-care, medical, or dental facility, to take any person presenting a security or safety risk at such premises into custody and detain the person in a reasonable manner on the premises for a reasonable time, for the purpose of summoning a law-enforcement officer."}], "other_titles": [{"note": "short title", "title": "Detention/Health-Care Facility/Permit/LE"}], "other_identifiers": [{"identifier": "ocd-bill-de-153-hb322"}], "actions": [{"description": "Introduced and Assigned to Judiciary Committee in House", "date": "2026-03-17", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["introduction", "referral-committee"], "related_entities": [{"name": "Judiciary", "entity_type": "organization", "organization_id": null}]}, {"description": "Reported Out of Committee (Judiciary) in House with 2 Favorable, 7 On Its Merits", "date": "2026-03-25", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["committee-passage", "committee-passage-favorable"], "related_entities": [{"name": "Judiciary", "entity_type": "organization", "organization_id": null}]}], "sponsorships": [{"name": "Mara Gorman", "classification": "primary", "entity_type": "person", "primary": true, "person_id": "~{\"chamber\": \"lower\", \"name\": \"Mara Gorman\"}", "organization_id": null}, {"name": "Marie Pinkney", "classification": "primary", "entity_type": "person", "primary": true, "person_id": "~{\"chamber\": \"upper\", \"name\": \"Marie Pinkney\"}", "organization_id": null}], "related_bills": [], "versions": [], "documents": [], "citations": [], "sources": [{"url": "https://legis.delaware.gov/BillDeta