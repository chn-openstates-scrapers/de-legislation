{"legislative_session": "153", "identifier": "HB 218", "title": "AN ACT TO AMEND TITLE 10 OF THE DELAWARE CODE RELATING TO INTERPERSONAL AND SEXUAL VIOLENCE IN THE MILITARY.", "from_organization": "~{\"classification\": \"lower\"}", "classification": ["bill"], "subject": [], "abstracts": [{"note": "synopsis", "abstract": "This Act requires that the court consider the existence of a military protective order as a significant factor in favor of granting an ex parte protective order.   It further requires that a law-enforcement officer notify the agency that entered a military protective order against an individual, if the law-enforcement officer has probable cause to believe that the individual violated the military protective order."}], "other_titles": [{"note": "short title", "title": "Military Protective Order/State Court Consideration"}], "other_identifiers": [{"identifier": "ocd-bill-de-153-hb218"}], "actions": [{"description": "Adopted in lieu of the original bill HB 218, and Assigned to Judiciary Committee in House", "date": "2026-05-19", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["introduction", "referral-committee"], "related_entities": [{"name": "Judiciary", "entity_type": "organization", "organization_id": null}]}], "sponsorships": [{"name": "Nnamdi O. Chukwuocha", "classification": "primary", "entity_type": "person", "primary": true, "person_id": "~{\"chamber\": \"lower\", \"name\": \"Nnamdi O. Chukwuocha\"}", "organization_id": null}, {"name": "Nicole Poore", "classification": "primary", "entity_type": "person", "primary": true, "person_id": "~{\"chamber\": \"upper\", \"name\": \"Nicole Poore\"}", "organization_id": null}, {"name": "Cyndie Romer", "classification": "primary", "entity_type": "person", "primary": true, "person_id": "~{\"chamber\": \"lower\", \"name\": \"Cyndie Romer\"}", "organization_id": null}, {"name": "Eric Morrison", "classification": "primary", "entity_type": "person", "primary": true, "person_id": "~{\"