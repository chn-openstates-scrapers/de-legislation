{"legislative_session": "153", "identifier": "HB 386", "title": "AN ACT TO AMEND TITLE 30 OF THE DELAWARE CODE RELATING TO PERSONAL INCOME TAX DEDUCTION OR CREDITS APPLICABLE TO QUALIFIED TIP INCOME.", "from_organization": "~{\"classification\": \"lower\"}", "classification": ["bill"], "subject": [], "abstracts": [{"note": "synopsis", "abstract": "This Act establishes the Tipped Worker Tax Relief Act of 2026 to provide targeted state income tax relief to resident and nonresident tipped workers in Delaware. It creates a deduction of up to $15,000 on qualified tips and converts it to a refundable credit for low-income resident earners. The program sunsets in 2029 unless renewed after review. This legislation promotes fairness, supports workforce retention in small business community, and addresses affordability challenges without new taxes or mandates on employers."}], "other_titles": [{"note": "short title", "title": "Tipped Worker Tax Relief Act of 2026/Establish"}], "other_identifiers": [{"identifier": "ocd-bill-de-153-hb386"}], "actions": [{"description": "Introduced and Assigned to Revenue & Finance Committee in House", "date": "2026-04-30", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["introduction", "referral-committee"], "related_entities": [{"name": "Revenue & Finance", "entity_type": "organization", "organization_id": null}]}, {"description": "Not Worked in Committee", "date": "2026-06-10", "organization_id": "~{\"classification\": \"lower\"}", "classification": [], "related_entities": []}], "sponsorships": [{"name": "Jeff Hilovsky", "classification": "primary", "entity_type": "person", "primary": true, "person_id": "~{\"chamber\": \"lower\", \"name\": \"Jeff Hilovsky\"}", "organization_id": null}, {"name": "Bryant L. Richardson", "classification": "primary", "entity_type": "person", "primary": true, "person_id": "~{\"chamber\": \"upper\", \"name\": \"Bryant L. Richardson\"}", "organization_id": null}, {"name": "Franklin D. Cooke