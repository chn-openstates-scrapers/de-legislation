{"legislative_session": "153", "identifier": "HB 445", "title": "AN ACT TO AMEND TITLE 26 AND TITLE 29 OF THE DELAWARE CODE RELATING TO LARGE ENERGY USE FACILITIES.", "from_organization": "~{\"classification\": \"lower\"}", "classification": ["bill"], "subject": [], "abstracts": [{"note": "synopsis", "abstract": "This Act requires large energy use facilities to produce renewable energy within the state to power their operations to prevent a drain on the electric grid. It provides for a \u201cramp-up\u201d period requiring that a large energy use facility provide a plan to the Public Service Commission to ramp up their energy production within the state each year so that by the 10th year of operations, the facility is producing 100% of its energy usage through in-state production.\r\n \r\nThis Act also allows the Public Service Commission to regulate electric suppliers insofar as necessary to ensure that large energy use facilities do not negatively affect the reliability of the electric grid."}], "other_titles": [], "other_identifiers": [{"identifier": "ocd-bill-de-153-hb445"}], "actions": [{"description": "Introduced and Assigned to Natural Resources & Energy Committee in House", "date": "2026-05-21", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["introduction", "referral-committee"], "related_entities": [{"name": "Natural Resources & Energy", "entity_type": "organization", "organization_id": null}]}], "sponsorships": [{"name": "Debra Heffernan", "classification": "primary", "entity_type": "person", "primary": true, "person_id": "~{\"chamber\": \"lower\", \"name\": \"Debra Heffernan\"}", "organization_id": null}, {"name": "Trey Paradee", "classification": "primary", "entity_type": "person", "primary": true, "person_id": "~{\"chamber\": \"upper\", \"name\": \"Trey Paradee\"}", "organization_id": null}, {"name": "Melanie Ross Levin", "classification": "primary", "entity_type": "person", "primary": true, "person_id": "~{\"chamber\": \"lower