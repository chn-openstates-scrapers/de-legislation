{"legislative_session": "153", "identifier": "SB 246", "title": "AN ACT TO AMEND TITLE 14 OF THE DELAWARE CODE RELATING TO DRIVER EDUCATION CERTIFICATION.", "from_organization": "~{\"classification\": \"upper\"}", "classification": ["bill"], "subject": [], "abstracts": [{"note": "synopsis", "abstract": "This Act updates how academic eligibility for driver education certification is calculated because many high schools have moved from the traditional 7-period school day to various forms of block scheduling. Under this Act, the Department of Education must establish, through regulations, how equivalent credit is calculated for courses taught on a block schedule or when the full length of a course is less than 1 year. This Act also adds world language to the academic courses from which a student may satisfy the credit requirement.\r\n\r\nThis Act also makes technical corrections to conform existing law to the standards of the Delaware Legislative Drafting Manual."}], "other_titles": [{"note": "short title", "title": "Driver Education/Certification/Eligibility/Updates"}], "other_identifiers": [{"identifier": "ocd-bill-de-153-sb246"}], "actions": [{"description": "Introduced and Assigned to Education Committee in Senate", "date": "2026-03-05", "organization_id": "~{\"classification\": \"upper\"}", "classification": ["introduction", "referral-committee"], "related_entities": [{"name": "Education", "entity_type": "organization", "organization_id": null}]}, {"description": "Reported Out of Committee (Education) in Senate with 5 On Its Merits", "date": "2026-03-11", "organization_id": "~{\"classification\": \"upper\"}", "classification": ["committee-passage"], "related_entities": [{"name": "Education", "entity_type": "organization", "organization_id": null}]}, {"description": "Amendment SA 1 to SB 246 - Introduced and Placed With Bill", "date": "2026-03-11", "organization_id": "~{\"classification\": \"upper\"}", "classification": ["amendment-introduction"], "related_entities": []}], "sponsorships": [{"name": "Laura V. Sturgeon", "classification": "primary", "entity_type": "person", "primary": true, "person_id": "~{\"chamber\": \"upper\", \"name\": \"Laura V. Sturgeon\"}", "organization_id": null}, {"name": "Brian Pettyjohn", "classification": "primary", "entity_type": "person", "primary": true, "person_id": "~{\"chamber\": \"upper\", \"name\": \"Brian Pettyjohn\"}", "organization_id": null}, {"name": "Marie Pinkney", "classification": "primary", "entity_type": "person", "primary": true, "person_id": "~{\"chamber\": \"upper\", \"name\": \"Marie Pinkney\"}", "organization_id": null}, {"name": "David P. Sokola", "classification": "primary", "entity_type": "person", "primary": true, "person_id": "~{\"chamber\": \"upper\", \"name\": \"David P. Sokola\"}", "organization_id": null}, {"name": "Stell Parker Selby", "classification": "primary", "entity_type": "person", "primary": true, "person_id": "~{\"chamber\": \"lower\", \"name\": \"Stell Parker Selby\"}", "organization_id": null}], "related_bills": [], "versions": [], "documents": [], "citations": [], "sources": [{"url": "https://legis.delaware.gov/BillDetail?LegislationId=142883", "note": "text/html"}], "extras": {"amendment": "SA 1"}, "jurisdiction": {"id": "ocd-jurisdiction/country:us/state:de/government", "name": "Delaware", "classification": "state", "division_id": "ocd-division/country:us/state:de"}, "scraped_at": "2026-03-21T08:35:18+00:00", "_id": "730bf7e4-2500-11f1-bfcf-e620d1c22f36"}