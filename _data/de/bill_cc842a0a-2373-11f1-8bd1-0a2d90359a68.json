{"legislative_session": "153", "identifier": "HB 276", "title": "AN ACT TO AMEND TITLE 11 OF THE DELAWARE CODE RELATING TO THEFT.", "from_organization": "~{\"classification\": \"lower\"}", "classification": ["bill"], "subject": [], "abstracts": [{"note": "synopsis", "abstract": "This Act permits the value of items stolen at separate times to be grouped and prosecuted as one charge, if the thefts were part of a pattern. It also allows the occurrence of an act in one jurisdiction to be used as evidence of a pattern being charged in another jurisdiction.\r\nThis Act also makes technical corrections to existing law to conform to the standards of the Delaware Legislative Drafting Manual."}], "other_titles": [], "other_identifiers": [{"identifier": "ocd-bill-de-153-hb276"}], "actions": [{"description": "Introduced and Assigned to Judiciary Committee in House", "date": "2026-01-21", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["introduction", "referral-committee"], "related_entities": [{"name": "Judiciary", "entity_type": "organization", "organization_id": null}]}], "sponsorships": [{"name": "Franklin D. Cooke", "classification": "primary", "entity_type": "person", "primary": true, "person_id": "~{\"chamber\": \"lower\", \"name\": \"Franklin D. Cooke\"}", "organization_id": null}, {"name": "Nicole Poore", "classification": "primary", "entity_type": "person", "primary": true, "person_id": "~{\"chamber\": \"upper\", \"name\": \"Nicole Poore\"}", "organization_id": null}, {"name": "Stell Parker Selby", "classification": "primary", "entity_type": "person", "primary": true, "person_id": "~{\"chamber\": \"lower\", \"name\": \"Stell Parker Selby\"}", "organization_id": null}, {"name": "Richard G. Collins", "classification": "primary", "entity_type": "person", "primary": true, "person_id": "~{\"chamber\": \"lower\", \"name\": \"Richard G. Collins\"}", "organization_id": null}, {"name": "Edward S. Osienski", "classification": "primary", "entity_type": "