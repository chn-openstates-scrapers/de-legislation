{"legislative_session": "153", "identifier": "HB 321", "title": "AN ACT TO AMEND TITLE 29 OF THE DELAWARE CODE RELATING TO THE PROCEDURE FOR DISSEMINATION TO THE PUBLIC OF A PROPOSED AMENDMENT TO THE DELAWARE CONSTITUTION.", "from_organization": "~{\"classification\": \"lower\"}", "classification": ["bill"], "subject": [], "abstracts": [{"note": "synopsis", "abstract": "This Act amends the procedure for disseminating to the public a proposed amendment to the Delaware Constitution by eliminating the requirement that the dissemination through publication in a newspaper. \r\n\r\nRemoving this requirement is expected to result in cost savings for the State, while still requiring the posting on state websites to ensure continued public accessibility."}], "other_titles": [], "other_identifiers": [{"identifier": "ocd-bill-de-153-hb321"}], "actions": [{"description": "Introduced and Assigned to Administration Committee in House", "date": "2026-03-11", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["introduction", "referral-committee"], "related_entities": [{"name": "Administration", "entity_type": "organization", "organization_id": null}]}], "sponsorships": [{"name": "Melissa Minor-Brown", "classification": "primary", "entity_type": "person", "primary": true, "person_id": "~{\"chamber\": \"lower\", \"name\": \"Melissa Minor-Brown\"}", "organization_id": null}, {"name": "Kerri Evelyn Harris", "classification": "primary", "entity_type": "person", "primary": true, "person_id": "~{\"chamber\": \"lower\", \"name\": \"Kerri Evelyn Harris\"}", "organization_id": null}, {"name": "Edward S. Osienski", "classification": "primary", "entity_type": "person", "primary": true, "person_id": "~{\"chamber\": \"lower\", \"name\": \"Edward S. Osienski\"}", "organization_id": null}, {"name": "Bryan Townsend", "classification": "primary", "entity_type": "person", "primary": true, "person_id": "~{\"chamber\": \"upper\", \"name\": \"Bryan Townsend\"}", "organization_id":