{"legislative_session": "153", "identifier": "HB 425", "title": "AN ACT TO AMEND TITLE 14 OF THE DELAWARE CODE RELATING TO EMPLOYEES AND SALARY SUPPLEMENTS.", "from_organization": "~{\"classification\": \"lower\"}", "classification": ["bill"], "subject": [], "abstracts": [{"note": "synopsis", "abstract": "This Act increases the salary supplement for school counselors and school nurses from 6% to 12% upon national certification. It further clarifies that salary supplements only apply if the employee is employed in the applicable profession and permits the DOE to identify additional positions subject to a salary supplement in Department regulations. \r\nThis Substitute includes school social workers in those employees eligible for a 12% salary supplement."}], "other_titles": [{"note": "short title", "title": "School Counselors and Nurses/Salary Supplement"}], "other_identifiers": [{"identifier": "ocd-bill-de-153-hb425"}], "actions": [{"description": "Adopted in lieu of the original bill HB 425, and Assigned to Education Committee in House", "date": "2026-06-09", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["introduction", "referral-committee"], "related_entities": [{"name": "Education", "entity_type": "organization", "organization_id": null}]}, {"description": "Reported Out of Committee (Education) in House with 1 Favorable, 12 On Its Merits", "date": "2026-06-10", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["committee-passage", "committee-passage-favorable"], "related_entities": [{"name": "Education", "entity_type": "organization", "organization_id": null}]}, {"description": "Assigned to Appropriations Committee in House", "date": "2026-06-11", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["introduction", "referral-committee"], "related_entities": [{"name": "Appropriations", "entity_type": "organization", "organization_id": null}]}, {"description": "Reported Out of Committee (Appropriations) in House with 6 On Its Merits", "date": "2026-06-16", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["committee-passage"], "related_entities": [{"name": "Appropriations", "entity_type": "organization", "organization_id": null}]}, {"description": "Reported Out of Committee (Appropriations) in House with 6 On Its Merits", "date": "2026-06-16", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["committee-passage"], "related_entities": [{"name": "Appropriations", "entity_type": "organization", "organization_id": null}]}], "sponsorships": [{"name": "Melissa Minor-Brown", "classification": "primary", "entity_type": "person", "primary": true, "person_id": "~{\"chamber\": \"lower\", \"name\": \"Melissa Minor-Brown\"}", "organization_id": null}, {"name": "Marie Pinkney", "classification": "primary", "entity_type": "person", "primary": true, "person_id": "~{\"chamber\": \"upper\", \"name\": \"Marie Pinkney\"}", "organization_id": null}], "related_bills": [], "versions": [], "documents": [{"note": "Fiscal Note", "links": [{"url": "https://legis.delaware.gov/json/BillDetail/GetPdfDocument?fileAttachmentId=655535", "media_type": "application/pdf"}], "date": "", "classification": ""}], "citations": [], "sources": [{"url": "https://legis.delaware.gov/BillDetail?LegislationId=143479", "note": "text/html"}], "extras": {"substitute": "HS 1"}, "jurisdiction": {"id": "ocd-jurisdiction/country:us/state:de/government", "name": "Delaware", "classification": "state", "division_id": "ocd-division/country:us/state:de"}, "scraped_at": "2026-06-18T12:32:25+00:00", "_id": "ab81e6fa-6b0b-11f1-9066-eeeff3010900"}