{"legislative_session": "153", "identifier": "HB 295", "title": "AN ACT TO AMEND TITLES 21 AND 29 OF THE DELAWARE CODE RELATING TO A DESIGNATED PARKING SPACE FOR VETERANS AT STATE BUILDINGS.", "from_organization": "~{\"classification\": \"lower\"}", "classification": ["bill"], "subject": [], "abstracts": [{"note": "synopsis", "abstract": "This Act provides that the Director of the Office of Management and Budget must designate 1 or more reserved parking spaces for a veteran at certain designated state buildings and facilities. It also prohibits stopping, standing, or parking in the veteran\u2019s space. \r\nViolations of this Act are exempted from the civil penalty for parking violations that exists in Title 21. \r\nThis Act takes effect 6 months after its enactment into law.   \r\nThis Act also makes technical corrections to conform existing law to the standards of the Delaware Legislative Drafting Manual."}], "other_titles": [], "other_identifiers": [], "actions": [{"description": "Introduced and Assigned to Administration Committee in House", "date": "2026-03-05", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["introduction", "referral-committee"], "related_entities": [{"name": "Administration", "entity_type": "organization", "organization_id": null}]}], "sponsorships": [{"name": "Alonna Berry", "classification": "primary", "entity_type": "person", "primary": true, "person_id": "~{\"chamber\": \"lower\", \"name\": \"Alonna Berry\"}", "organization_id": null}, {"name": "Brian Pettyjohn", "classification": "primary", "entity_type": "person", "primary": true, "person_id": "~{\"chamber\": \"upper\", \"name\": \"Brian Pettyjohn\"}", "organization_id": null}, {"name": "Marie Pinkney", "classification": "primary", "entity_type": "person", "primary": true, "person_id": "~{\"chamber\": \"upper\", \"name\": \"Marie Pinkney\"}", "organization_id": null}, {"name": "Mara Gorman", "classification": "primary", "entity_type": "person", "primary": true,