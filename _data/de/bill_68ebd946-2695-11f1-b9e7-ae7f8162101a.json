{"legislative_session": "153", "identifier": "HB 326", "title": "AN ACT TO AMEND TITLE 11 OF THE DELAWARE CODE RELATING TO THEFT BY IMPERSONATION OF A FAMILY MEMBER.", "from_organization": "~{\"classification\": \"lower\"}", "classification": ["bill"], "subject": [], "abstracts": [{"note": "synopsis", "abstract": "This Act increases the penalty when an individual commits theft by impersonating a family member of the victim.  A person convicted of a violation of this section shall be imprisoned for not less than 60 days. The minimum sentence under this section may not be suspended."}], "other_titles": [], "other_identifiers": [{"identifier": "ocd-bill-de-153-hb326"}], "actions": [{"description": "Introduced and Assigned to Judiciary Committee in House", "date": "2026-03-18", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["introduction", "referral-committee"], "related_entities": [{"name": "Judiciary", "entity_type": "organization", "organization_id": null}]}], "sponsorships": [{"name": "Eric Morrison", "classification": "primary", "entity_type": "person", "primary": true, "person_id": "~{\"chamber\": \"lower\", \"name\": \"Eric Morrison\"}", "organization_id": null}, {"name": "Claire Snyder-Hall", "classification": "primary", "entity_type": "person", "primary": true, "person_id": "~{\"chamber\": \"lower\", \"name\": \"Claire Snyder-Hall\"}", "organization_id": null}, {"name": "Nicole Poore", "classification": "primary", "entity_type": "person", "primary": true, "person_id": "~{\"chamber\": \"upper\", \"name\": \"Nicole Poore\"}", "organization_id": null}], "related_bills": [], "versions": [], "documents": [], "citations": [], "sources": [{"url": "https://legis.delaware.gov/BillDetail?LegislationId=142969", "note": "text/html"}], "extras": {}, "jurisdiction": {"id": "ocd-jurisdiction/country:us/state:de/government", "name": "Delaware", "classification": "state", "division_id": "ocd-division/country:us/state:de"}, "scraped_at": "2026-03-23T08