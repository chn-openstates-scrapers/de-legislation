{"legislative_session": "153", "identifier": "SB 232", "title": "AN ACT TO AMEND TITLE 11 OF THE DELAWARE CODE RELATING TO CRIMINAL MISCHIEF.", "from_organization": "~{\"classification\": \"upper\"}", "classification": ["bill"], "subject": [], "abstracts": [{"note": "synopsis", "abstract": "This Act increases for the crime of criminal mischief to a class F felony when the person intentionally causes damage to an authorized emergency vehicle resulting in a pecuniary loss of $5,000 or more or in the authorized emergency vehicle becoming temporarily unable to be used to respond to an emergency.\r\n\r\nThis Act also makes technical corrections to conform existing law to the standards of the Delaware Legislative Drafting Manual."}], "other_titles": [{"note": "short title", "title": "Criminal Mischief/Class F Felony/Damage/Authorized Emergency Vehicle"}], "other_identifiers": [], "actions": [{"description": "Introduced and Assigned to Judiciary Committee in Senate", "date": "2026-01-28", "organization_id": "~{\"classification\": \"upper\"}", "classification": ["introduction", "referral-committee"], "related_entities": [{"name": "Judiciary", "entity_type": "organization", "organization_id": null}]}], "sponsorships": [{"name": "David L. Wilson", "classification": "primary", "entity_type": "person", "primary": true, "person_id": "~{\"chamber\": \"upper\", \"name\": \"David L. Wilson\"}", "organization_id": null}, {"name": "Daniel B. Short", "classification": "primary", "entity_type": "person", "primary": true, "person_id": "~{\"chamber\": \"lower\", \"name\": \"Daniel B. Short\"}", "organization_id": null}, {"name": "Franklin D. Cooke", "classification": "primary", "entity_type": "person", "primary": true, "person_id": "~{\"chamber\": \"lower\", \"name\": \"Franklin D. Cooke\"}", "organization_id": null}, {"name": "Stell Parker Selby", "classification": "primary", "entity_type": "person", "primary": true, "person_id": "~{\"chamber\": \"lower\", \"name\": \"Stell Parker Selby