{"legislative_session": "153", "identifier": "HB 442", "title": "AN ACT TO AMEND TITLE 21 OF THE DELAWARE CODE RELATING TO TRAFFIC MONITORING SYSTEMS.", "from_organization": "~{\"classification\": \"lower\"}", "classification": ["bill"], "subject": [], "abstracts": [{"note": "synopsis", "abstract": "This Act creates a new chapter in Title 21 pertaining to electronic traffic violation monitoring systems, and moves the existing language from section 4170A pertaining to electronic speed monitoring systems to the new chapter. This Act also removes the sunset provision from the existing Laws of Delaware concerning the use of electronic speed monitoring systems. The Act further modifies the language to allow for the use of electronic monitoring systems for all traffic violations."}], "other_titles": [{"note": "short title", "title": "Electronic Traffic Violation Monitoring System/Updates"}], "other_identifiers": [{"identifier": "ocd-bill-de-153-hb442"}], "actions": [{"description": "Introduced and Assigned to Public Safety & Homeland Security Committee in House", "date": "2026-05-21", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["introduction", "referral-committee"], "related_entities": [{"name": "Public Safety & Homeland Security", "entity_type": "organization", "organization_id": null}]}, {"description": "Reported Out of Committee (Public Safety & Homeland Security) in House with 6 On Its Merits", "date": "2026-06-09", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["committee-passage"], "related_entities": [{"name": "Public Safety & Homeland Security", "entity_type": "organization", "organization_id": null}]}, {"description": "Amendment HA 1 to HB 442 - Introduced and Placed With Bill", "date": "2026-06-09", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["amendment-introduction"], "related_entities": []}], "sponsorships": [{"name": "Edward S. Osienski", "classification": "primary", "entit