{"legislative_session": "153", "identifier": "HB 323", "title": "AN ACT TO AMEND TITLE 29 OF THE DELAWARE CODE RELATING TO THE DEPARTMENT OF FINANCE AND CRIMINAL BACKGROUND CHECKS.", "from_organization": "~{\"classification\": \"lower\"}", "classification": ["bill"], "subject": [], "abstracts": [{"note": "synopsis", "abstract": "This Act makes a technical correction to the specific categories of persons required to obtain a fingerprint-based background check under Chapter 83 of Title 29 of the Delaware Code to comply with the requirements of Public Law (Pub. L.) 92-544 for access to FBI criminal history record information. The Department of Finance applied for federal \u201cRap Back\u201d reporting and was denied, so the unacceptable language is being eliminated to facilitate access."}], "other_titles": [], "other_identifiers": [{"identifier": "ocd-bill-de-153-hb323"}], "actions": [{"description": "Introduced and Assigned to Administration Committee in House", "date": "2026-03-17", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["introduction", "referral-committee"], "related_entities": [{"name": "Administration", "entity_type": "organization", "organization_id": null}]}], "sponsorships": [{"name": "Edward S. Osienski", "classification": "primary", "entity_type": "person", "primary": true, "person_id": "~{\"chamber\": \"lower\", \"name\": \"Edward S. Osienski\"}", "organization_id": null}, {"name": "Nicole Poore", "classification": "primary", "entity_type": "person", "primary": true, "person_id": "~{\"chamber\": \"upper\", \"name\": \"Nicole Poore\"}", "organization_id": null}, {"name": "Claire Snyder-Hall", "classification": "primary", "entity_type": "person", "primary": true, "person_id": "~{\"chamber\": \"lower\", \"name\": \"Claire Snyder-Hall\"}", "organization_id": null}, {"name": "Brian Pettyjohn", "classification": "primary", "entity_type": "person", "primary": true, "person_id": "~{\"chamber\": \"upper\", \"name\": \"Brian Pettyjoh