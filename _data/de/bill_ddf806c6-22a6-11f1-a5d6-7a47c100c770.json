{"legislative_session": "153", "identifier": "HB 17", "title": "AN ACT TO AMEND TITLE 16 OF THE DELAWARE CODE RELATING TO CERTIFICATE OF PUBLIC REVIEW.", "from_organization": "~{\"classification\": \"lower\"}", "classification": ["bill"], "subject": [], "abstracts": [{"note": "synopsis", "abstract": "This Act repeals the requirement that a person must apply for a certificate of public review prior to the acquisition of major medical equipment. A certificate of public review may still be required if the acquisition meets the capital expenditure threshold under \u00a7 9304(a)(2) of Title 16.\r\nThis Act also makes technical corrections to conform with the Delaware Legislative Drafting Manual and restores a missing word to \u00a7 9304(a)(2) of Title 16."}], "other_titles": [], "other_identifiers": [{"identifier": "ocd-bill-de-153-hb17"}], "actions": [{"description": "Introduced and Assigned to Health & Human Development Committee in House", "date": "2026-03-05", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["introduction", "referral-committee"], "related_entities": [{"name": "Health & Human Development", "entity_type": "organization", "organization_id": null}]}], "sponsorships": [{"name": "Kerri Evelyn Harris", "classification": "primary", "entity_type": "person", "primary": true, "person_id": "~{\"chamber\": \"lower\", \"name\": \"Kerri Evelyn Harris\"}", "organization_id": null}, {"name": "Marie Pinkney", "classification": "primary", "entity_type": "person", "primary": true, "person_id": "~{\"chamber\": \"upper\", \"name\": \"Marie Pinkney\"}", "organization_id": null}, {"name": "Laura V. Sturgeon", "classification": "primary", "entity_type": "person", "primary": true, "person_id": "~{\"chamber\": \"upper\", \"name\": \"Laura V. Sturgeon\"}", "organization_id": null}, {"name": "Eric Morrison", "classification": "primary", "entity_type": "person", "primary": true, "person_id": "~{\"chamber\": \"lower\", \"name\": \"Eric Morrison\"}", "organ