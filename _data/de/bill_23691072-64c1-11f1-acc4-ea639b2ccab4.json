{"legislative_session": "153", "identifier": "HB 382", "title": "AN ACT TO AMEND TITLES 6 AND 21 OF THE DELAWARE CODE RELATING TO RENTAL CARS AND PEER- TO-PEER CAR SHARING LOSS OF USE.", "from_organization": "~{\"classification\": \"lower\"}", "classification": ["bill"], "subject": [], "abstracts": [{"note": "synopsis", "abstract": "This Act allows rental car companies and peer-to-peer car sharing programs to recover loss of use damages from any rental car drivers, shared vehicle drivers, or the negligent party\u2019s insurer caused by any renter or an authorized driver\u2019s negligent, intentional, willful, or criminal acts resulting in a loss of the vehicle\u2019s use."}], "other_titles": [], "other_identifiers": [{"identifier": "ocd-bill-de-153-hb382"}], "actions": [{"description": "Introduced and Assigned to Economic Development/Banking/Insurance & Commerce Committee in House", "date": "2026-04-23", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["introduction", "referral-committee"], "related_entities": [{"name": "Economic Development/Banking/Insurance & Commerce", "entity_type": "organization", "organization_id": null}]}], "sponsorships": [{"name": "Sean M. Lynn", "classification": "primary", "entity_type": "person", "primary": true, "person_id": "~{\"chamber\": \"lower\", \"name\": \"Sean M. Lynn\"}", "organization_id": null}, {"name": "Claire Snyder-Hall", "classification": "primary", "entity_type": "person", "primary": true, "person_id": "~{\"chamber\": \"lower\", \"name\": \"Claire Snyder-Hall\"}", "organization_id": null}], "related_bills": [], "versions": [], "documents": [], "citations": [], "sources": [{"url": "https://legis.delaware.gov/BillDetail?LegislationId=143166", "note": "text/html"}], "extras": {}, "jurisdiction": {"id": "ocd-jurisdiction/country:us/state:de/government", "name": "Delaware", "classification": "state", "division_id": "ocd-division/country:us/state:de"}, "scraped_at": "2026-06-10T12:25:26+00:00", "_id":