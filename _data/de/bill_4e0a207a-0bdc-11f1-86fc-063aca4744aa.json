{"legislative_session": "153", "identifier": "HB 283", "title": "AN ACT TO AMEND TITLE 30 OF THE DELAWARE CODE RELATING TO THE REALTY TRANSFER TAX.", "from_organization": "~{\"classification\": \"lower\"}", "classification": ["bill"], "subject": [], "abstracts": [{"note": "synopsis", "abstract": "This Act provides updates to Title 30 relating to the Realty Transfer Tax. First it clarifies that the exception for spouses is not solely limited between a husband and wife and instead applies to spouses in general.  It also adds an exception for conveyances between grandparents and their grandchildren or the spouse of such a grandchild."}], "other_titles": [], "other_identifiers": [], "actions": [{"description": "Introduced and Assigned to Revenue & Finance Committee in House", "date": "2026-01-27", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["introduction", "referral-committee"], "related_entities": [{"name": "Revenue & Finance", "entity_type": "organization", "organization_id": null}]}], "sponsorships": [{"name": "Kevin S Hensley", "classification": "primary", "entity_type": "person", "primary": true, "person_id": "~{\"chamber\": \"lower\", \"name\": \"Kevin S Hensley\"}", "organization_id": null}, {"name": "Melanie Ross Levin", "classification": "primary", "entity_type": "person", "primary": true, "person_id": "~{\"chamber\": \"lower\", \"name\": \"Melanie Ross Levin\"}", "organization_id": null}, {"name": "Michael F. Smith", "classification": "primary", "entity_type": "person", "primary": true, "person_id": "~{\"chamber\": \"lower\", \"name\": \"Michael F. Smith\"}", "organization_id": null}, {"name": "Lyndon D. Yearick", "classification": "primary", "entity_type": "person", "primary": true, "person_id": "~{\"chamber\": \"lower\", \"name\": \"Lyndon D. Yearick\"}", "organization_id": null}, {"name": "Stell Parker Selby", "classification": "primary", "entity_type": "person", "primary": true, "person_id": "~{\"chamber\": \"lower\", \"name\"