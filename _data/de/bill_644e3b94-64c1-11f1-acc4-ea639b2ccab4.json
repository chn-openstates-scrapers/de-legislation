{"legislative_session": "153", "identifier": "HB 341", "title": "AN ACT TO AMEND TITLE 29 OF THE DELAWARE CODE RELATING TO CHILD SUPPORT.", "from_organization": "~{\"classification\": \"lower\"}", "classification": ["bill"], "subject": [], "abstracts": [{"note": "synopsis", "abstract": "This Act creates a presumption that parents are not liable for the care, maintenance, and support of children committed to DSCYF, or admitted to a service provided by DSCYF.  The Family Court may order child support payments only if child support will not pose a barrier to parent reunification."}], "other_titles": [{"note": "short title", "title": "Support of Child/DSCYF/Parents/Liability"}], "other_identifiers": [{"identifier": "ocd-bill-de-153-hb341"}], "actions": [{"description": "Introduced and Assigned to Health & Human Development Committee in House", "date": "2026-04-09", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["introduction", "referral-committee"], "related_entities": [{"name": "Health & Human Development", "entity_type": "organization", "organization_id": null}]}, {"description": "Reported Out of Committee (Health & Human Development) in House with 2 Favorable, 11 On Its Merits", "date": "2026-04-15", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["committee-passage", "committee-passage-favorable"], "related_entities": [{"name": "Health & Human Development", "entity_type": "organization", "organization_id": null}]}, {"description": "Amendment HA 1 to HB 341 - Introduced and Placed With Bill", "date": "2026-04-16", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["amendment-introduction"], "related_entities": []}, {"description": "Assigned to Appropriations Committee in House", "date": "2026-04-16", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["introduction", "referral-committee"], "related_entities": [{"name": "Appropriations", "entity_type": "organization", "or