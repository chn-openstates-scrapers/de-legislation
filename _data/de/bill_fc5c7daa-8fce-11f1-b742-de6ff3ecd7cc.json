{"legislative_session": "153", "identifier": "HB 211", "title": "AN ACT TO AMEND TITLE 29 OF THE DELAWARE CODE RELATING TO THE INNOVATING DELAWARE ACT.", "from_organization": "~{\"classification\": \"lower\"}", "classification": ["bill"], "subject": [], "abstracts": [{"note": "synopsis", "abstract": "This Substitute for House Bill 211 creates the Innovate Delaware Program. This Program allows an Economic Development Organization to apply for a tax credit program through the Division of Small Business. \r\nThis Substitute also lowers the cap on appropriations to support the tax credit program from 10 million to 3 million dollars in a calendar year."}], "other_titles": [{"note": "short title", "title": "Innovate DE Program/Create"}], "other_identifiers": [{"identifier": "ocd-bill-de-153-hb211"}], "actions": [], "sponsorships": [{"name": "William Bush", "classification": "primary", "entity_type": "person", "primary": true, "person_id": "~{\"chamber\": \"lower\", \"name\": \"William Bush\"}", "organization_id": null}, {"name": "Darius J. Brown", "classification": "primary", "entity_type": "person", "primary": true, "person_id": "~{\"chamber\": \"upper\", \"name\": \"Darius J. Brown\"}", "organization_id": null}], "related_bills": [], "versions": [], "documents": [], "citations": [], "sources": [{"url": "https://legis.delaware.gov/BillDetail?LegislationId=143680", "note": "text/html"}], "extras": {"substitute": "HS 1"}, "jurisdiction": {"id": "ocd-jurisdiction/country:us/state:de/government", "name": "Delaware", "classification": "state", "division_id": "ocd-division/country:us/state:de"}, "scraped_at": "2026-08-04T07:17:56+00:00", "_id": "fc5c7daa-8fce-11f1-b742-de6ff3ecd7cc"}