{"legislative_session": "153", "identifier": "HB 422", "title": "AN ACT TO AMEND TITLE 16 OF THE DELAWARE CODE RELATING TO ENHANCED INFORMED CONSENT FOR INFANT VACCINATIONS AND DOCUMENTATION IN SUDDEN UNEXPECTED INFANT DEATH INVESTIGATIONS.", "from_organization": "~{\"classification\": \"lower\"}", "classification": ["bill"], "subject": [], "abstracts": [{"note": "synopsis", "abstract": "This Act requires enhanced informed consent before administering vaccines to infants under 12 months of age. Providers must discuss possible side effects, the overlap between the 2\u20134-month vaccination, and how to report events to VAERS or file VICP claims. A signed acknowledgment form (developed by DHSS) is required. The Act also mandates that vaccination history be documented in every SUID/SIDS investigation to support accurate cause-of-death determinations. These measures directly respond to families\u2019 requests for greater transparency following the loss of healthy infants shortly after routine vaccinations, while preserving access to recommended immunizations."}], "other_titles": [], "other_identifiers": [{"identifier": "ocd-bill-de-153-hb422"}], "actions": [{"description": "Introduced and Assigned to Health & Human Development Committee in House", "date": "2026-05-14", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["introduction", "referral-committee"], "related_entities": [{"name": "Health & Human Development", "entity_type": "organization", "organization_id": null}]}], "sponsorships": [{"name": "Jeff Hilovsky", "classification": "primary", "entity_type": "person", "primary": true, "person_id": "~{\"chamber\": \"lower\", \"name\": \"Jeff Hilovsky\"}", "organization_id": null}, {"name": "Bryant L. Richardson", "classification": "primary", "entity_type": "person", "primary": true, "person_id": "~{\"chamber\": \"upper\", \"name\": \"Bryant L. Richardson\"}", "organization_id": null}, {"name": "Bryan W. Shupe", "classification": "primary", "entit