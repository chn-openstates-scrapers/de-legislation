{"legislative_session": "153", "identifier": "HB 329", "title": "AN ACT TO AMEND TITLES 20 AND 29 OF THE DELAWARE CODE RELATING TO EMERGENCY MANAGEMENT AND EMERGENCY REGULATIONS.", "from_organization": "~{\"classification\": \"lower\"}", "classification": ["bill"], "subject": [], "abstracts": [{"note": "synopsis", "abstract": "This Act's purpose is to create checks and balances between the Executive and legislative Branches of State government relating to Emergency Orders.\r\nThis Act recognizes the authority of the Governor to act in the event of an emergency by allowing the Governor to declare an emergency for 120 days and to renew that order for up to 60 more days, for a total of 180 days.\r\nThereafter, to extend or renew the emergency order beyond the 180 days, such order will require the approval of the General Assembly.\r\nThe Governor may terminate any emergency order or renewal order at any time."}], "other_titles": [], "other_identifiers": [{"identifier": "ocd-bill-de-153-hb329"}], "actions": [{"description": "Introduced and Assigned to Administration Committee in House", "date": "2026-03-25", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["introduction", "referral-committee"], "related_entities": [{"name": "Administration", "entity_type": "organization", "organization_id": null}]}], "sponsorships": [{"name": "Richard G. Collins", "classification": "primary", "entity_type": "person", "primary": true, "person_id": "~{\"chamber\": \"lower\", \"name\": \"Richard G. Collins\"}", "organization_id": null}, {"name": "Claire Snyder-Hall", "classification": "primary", "entity_type": "person", "primary": true, "person_id": "~{\"chamber\": \"lower\", \"name\": \"Claire Snyder-Hall\"}", "organization_id": null}, {"name": "Bryant L. Richardson", "classification": "primary", "entity_type": "person", "primary": true, "person_id": "~{\"chamber\": \"upper\", \"name\": \"Bryant L. Richardson\"}", "organization_id": null}, {"name": "Laura V. Sturge